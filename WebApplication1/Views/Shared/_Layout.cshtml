@using System.Security.Claims

<!DOCTYPE html>
<html>

<head>
    <meta charset="UTF-8">
    <title>@ViewData["Title"]</title>

    <link rel="stylesheet" href="~/css/black-cat.css" />
</head>

<body>
    <header>
        <h1>Кофейня «Чёрный Кот»</h1>
        <nav>
            <a asp-controller="Home" asp-action="Index">Главная</a>
            <a asp-controller="Home" asp-action="Menu">Меню</a>
            <a asp-controller="Home" asp-action="Contacts">Контакты</a>

            @{
                if (!User.Identity.IsAuthenticated)
                {
                    <a asp-controller="Account" asp-action="LogIn">Войти</a>
                    <a asp-controller="Account" asp-action="SignIn">Регистрация</a>
                }
                else
                {
                    // User - текущий пользователь
                    // FindFirst - найти первое совпадение
                    // ClaimsIdentity.DefaultNameClaimType - тип данных, который содержит имя пользователя

                    <text>Привет, @User.FindFirst(ClaimTypes.Name).Value [@User.FindFirst(ClaimTypes.DateOfBirth).Value]</text>
                    <a asp-controller="Account" asp-action="LogOut">Выйти</a>
                }
            }
        </nav>
    </header>


    <div>
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer>
        <p>📍 Алматы | ⏰ 08:00 – 22:00</p>
        <p>© 2026 Кофейня «Чёрный Кот»</p>
    </footer>

</body>

</html>
